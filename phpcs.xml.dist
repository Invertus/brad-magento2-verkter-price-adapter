<?xml version="1.0"?>
<ruleset name="Magenmagic_BradSearchPrice">
    <description>PHP_CodeSniffer ruleset for the Verkter price adapter. Extends Magento2.</description>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php,phtml"/>
    <arg name="colors"/>
    <arg name="severity" value="10"/>

    <file>etc</file>
    <file>Model</file>
    <file>registration.php</file>

    <exclude-pattern>*/Test/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <rule ref="Magento2"/>
</ruleset>
